{
    "name": "forml",
    "version": "2.0.0-next.10",
    "description": "Small, fast, and powerful JSON-schema form generator for React.",
    "keywords": [
        "forml",
        "json",
        "schema",
        "form",
        "json schema",
        "schema form",
        "json form",
        "react",
        "react-component"
    ],
    "main": "lib/index.js",
    "scripts": {
        "dev": "npm run -w @forml/example start",
        "lint": "eslint pacakges/*/src/**/*.jsx",
        "build": "lerna run build",
        "watch": "lerna run --parallel watch --stream",
        "test": "jest --coverage --verbose"
    },
    "author": "Zachary Hueras",
    "license": "MIT",
    "homepage": "https://forml.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/forml-js/forml.git"
    },
    "devDependencies": {
        "@date-io/moment": "^3.2.0",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^10.0.1",
        "@testing-library/jest-dom": "^6.6.3",
        "@testing-library/react": "^16.2.0",
        "ajv": "^8.17.1",
        "clsx": "^2.1.1",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "jsdom": "^26.0.0",
        "lerna": "^8.2.0",
        "moment": "^2.30.1",
        "moment-timezone": "^0.5.47",
        "nx": "^20.4.6",
        "objectpath": "^2.0.0",
        "prop-types": "^15.8.1",
        "react": ">=19.0.0",
        "react-dom": ">=19.0.0",
        "react-test-renderer": "^19.0.0",
        "semantic-release": "^24.2.3",
        "semantic-release-lerna": "^2.11.1",
        "shortid": "^2.2.17"
    },
    "workspaces": [
        "packages/context",
        "packages/decorator-mui",
        "packages/decorator-barebones",
        "packages/ware",
        "packages/decorator-bootstrap",
        "packages/hooks",
        "packages/core",
        "packages/decorator-pdf",
        "example"
    ],
    "dependencies": {
        "@forml/context": "file:packages/context",
        "@forml/core": "file:packages/core",
        "@forml/decorator-barebones": "file:packages/decorator-barebones",
        "@forml/decorator-mui": "file:packages/decorator-mui",
        "@forml/decorator-pdf": "file:packages/decorator-pdf",
        "@forml/example": "file:example",
        "@forml/hooks": "file:packages/hooks"
    },
    "peerDependencies": {
        "react": ">=17.0.0",
        "react-dom": ">=17.0.0"
    }
}
