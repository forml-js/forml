{
    "name": "forml",
    "version": "2.0.0-next.20",
    "description": "Small, fast, and powerful JSON-schema form generator for React.",
    "keywords": [
        "forml",
        "json",
        "schema",
        "form",
        "json schema",
        "schema form",
        "json form",
        "react",
        "react-component"
    ],
    "scripts": {
        "dev": "npm run -w @forml/example start",
        "lint": "eslint pacakges/*/src/**/*.jsx",
        "build": "lerna run build",
        "watch": "lerna run --parallel watch --stream",
        "test": "cross-env NODE_ENV=test mocha --config .mocharc.cjs 'packages/*/test/**/*.test.{js,jsx}'"
    },
    "author": "Zachary Hueras",
    "license": "MIT",
    "homepage": "https://forml.dev",
    "repository": {
        "type": "git",
        "url": "https://github.com/forml-js/forml.git"
    },
    "devDependencies": {
        "@babel/core": "^7.29.0",
        "@babel/plugin-transform-runtime": "^7.29.0",
        "@babel/preset-env": "^7.29.2",
        "@babel/preset-react": "^7.28.5",
        "@babel/register": "^7.28.6",
        "@date-io/moment": "^3.2.0",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^10.0.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@vitest/expect": "^4.1.2",
        "ajv": "^8.18.0",
        "babel-loader": "^10.1.1",
        "c8": "^11.0.0",
        "chai": "^6.2.2",
        "chai-as-promised": "^8.0.2",
        "chai-dom": "^1.12.1",
        "clsx": "^2.1.1",
        "cross-env": "^10.1.0",
        "global-jsdom": "^29.0.0",
        "ignore-styles": "^5.0.1",
        "jsdom": "^29.0.1",
        "lerna": "^9.0.7",
        "mocha": "^11.7.5",
        "mocha-chai-jest-snapshot": "^1.1.7",
        "mocha-expect-snapshot": "^8.0.0",
        "moment": "^2.30.1",
        "moment-timezone": "^0.6.1",
        "monocart-coverage-reports": "^2.12.9",
        "nx": "^22.6.4",
        "objectpath": "^2.0.0",
        "prop-types": "^15.8.1",
        "react": ">=19.2.4",
        "react-dom": ">=19.2.4",
        "react-test-renderer": "^19.2.4",
        "semantic-release": "^25.0.3",
        "semantic-release-lerna": "^2.18.3",
        "shortid": "^2.2.17",
        "sinon": "^21.0.3",
        "sinon-chai": "^4.0.1",
        "source-map-support": "^0.5.21",
        "webpack-cli": "^7.0.2"
    },
    "workspaces": [
        "packages/context",
        "packages/decorator-mantine",
        "packages/decorator-mui",
        "packages/decorator-barebones",
        "packages/ware",
        "packages/decorator-bootstrap",
        "packages/hooks",
        "packages/core",
        "packages/decorator-pdf",
        "example"
    ],
    "dependencies": {
        "@forml/context": "file:packages/context",
        "@forml/core": "file:packages/core",
        "@forml/decorator-barebones": "file:packages/decorator-barebones",
        "@forml/decorator-mantine": "file:packages/decorator-mantine",
        "@forml/decorator-mui": "file:packages/decorator-mui",
        "@forml/decorator-pdf": "file:packages/decorator-pdf",
        "@forml/example": "file:example",
        "@forml/hooks": "file:packages/hooks"
    },
    "peerDependencies": {
        "react": ">=17.0.0",
        "react-dom": ">=17.0.0"
    }
}
